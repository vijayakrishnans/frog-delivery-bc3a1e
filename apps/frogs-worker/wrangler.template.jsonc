{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "frogs-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "local"
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "frog-delivery-db-{{ENVIRONMENT}}",
      "database_id": "{{WIRING_CLOUDFLARE_D1.databaseId}}"
    }
  ]
}